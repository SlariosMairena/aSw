# =====================================================================
# CONFIGURACIÓN DE ENTORNO (.env.example)
# Copia este archivo a ".env" y completa tus credenciales.
# =====================================================================

# --- 1. ENTORNO Y SERVIDOR ---
APP_NAME="SaaS Bot de Pedidos WhatsApp"
ENVIRONMENT="development" # development | production
PORT=8000
BASE_URL="http://localhost:8000"
WHATSAPP_BOT_PUBLIC_NUMBER="5215500000000" # Tu único número de WhatsApp para generar los links de la Opción B

# --- 2. BASE DE DATOS (NEON.TECH POSTGRESQL SERVERLESS) ---
# Pega aquí tu URL de Neon.tech (con ?sslmode=require).
# Si lo dejas vacío o con sqlite en desarrollo local, usará SQLite automáticamente para que puedas probar al instante.
# Ejemplo Neon.tech: DATABASE_URL="postgresql+psycopg://usuario:password@ep-ejemplo-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="sqlite:///./saas_whatsapp_bot.db"

# --- 3. SEGURIDAD EMPRESARIAL (ISO/IEC 27001 & OWASP ASVS) ---
SECRET_KEY="cambia-esta-clave-secreta-jwt-con-al-menos-64-caracteres-aleatorios-2026"
ENCRYPTION_MASTER_KEY="cambia-esta-llave-maestra-aes256-para-cifrar-tokens-en-bd"
WEBHOOK_HMAC_SECRET="cambia-este-secreto-hmac-sha256-para-validar-webhooks"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false # Cambiar a true en HTTPS (Render / Producción)

# Credenciales Iniciales de tu Cuenta SUPER_ADMIN (Dueño del SaaS)
SUPERADMIN_EMAIL="admin@tusaas.com"
SUPERADMIN_PASSWORD="AdminSaaS#2026!Seguro"
SUPERADMIN_NAME="Administrador General SaaS"

# --- 4. ENRUTADOR MULTI-IA (Respaldo Automático entre IAs Gratis + Opción de Pago) ---
# Orden de prioridad separado por comas: gemini,groq,openrouter,openai
AI_PROVIDER_PRIORITY="gemini,groq,openrouter,openai"

# Opción Gratis 1: Google Gemini (Google AI Studio)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Opción Gratis 2: Groq Cloud (Ultra rápido)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Opción Gratis 3: OpenRouter (Modelos gratuitos)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.1-8b-instruct:free"

# Opción Empresarial de Pago (Cuando decidas activarla)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- 5. CONEXIÓN WHATSAPP (SOLO NIVEL 1 Y NIVEL 2) ---
# Opciones: "evolution_qr" (Nivel 1 por Código QR) | "meta_cloud" (Nivel 2 API Oficial de Meta)
WHATSAPP_PROVIDER="evolution_qr"

# Nivel 1: Evolution API (Código QR)
WHATSAPP_EVOLUTION_BASE_URL="http://localhost:8080"
WHATSAPP_EVOLUTION_API_KEY="cambiar_esta_llave_en_env"
WHATSAPP_EVOLUTION_INSTANCE="saas_bot_principal"

# Nivel 2: WhatsApp Cloud API Oficial de Meta (Para migración futura)
WHATSAPP_META_ACCESS_TOKEN=""
WHATSAPP_META_PHONE_NUMBER_ID=""
WHATSAPP_META_VERIFY_TOKEN="token_verificacion_meta_2026"
WHATSAPP_META_APP_SECRET=""

# --- 6. MÉTODOS DE PAGO Y RESERVACIÓN DE MESAS ---
# "modo_1_directo" (Efectivo con cambio y Transferencia con foto de comprobante)
# "modo_2_pasarela_api" (Activa cobros por API y habilita automáticamente la Reservación de Mesas con anticipo)
PAYMENT_OPERATION_MODE="modo_1_directo"
ENABLE_TABLE_RESERVATIONS_WITH_PAYMENT=false
STRIPE_SECRET_KEY=""
MERCADOPAGO_ACCESS_TOKEN=""

